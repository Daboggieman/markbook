# Markbook environment variables (docs/handover_docs/08-repo-structure-and-hygiene.md).
# Copy to .env for local dev; .env is gitignored. Secrets never go in the repo.

# App
MARKBOOK_ENVIRONMENT=dev
MARKBOOK_LOG_LEVEL=INFO
MARKBOOK_LOG_FORMAT=json

# Database — the app role. NOT a superuser; RLS applies.
# Host port 5433 = infra/compose.dev.yml's mapping (container 5432).
MARKBOOK_DATABASE_URL=postgresql+psycopg://markbook_app:markbook_app_dev_password@localhost:5433/markbook

# Redis — host port 6380 = compose.dev.yml's mapping (container 6379).
MARKBOOK_REDIS_URL=redis://localhost:6380/0

# Object storage (S3-compatible; MinIO in dev)
MARKBOOK_S3_ENDPOINT=http://localhost:9000
MARKBOOK_S3_BUCKET=markbook-dev
MARKBOOK_S3_ACCESS_KEY=markbook
MARKBOOK_S3_SECRET_KEY=markbook_dev_password

# Auth
MARKBOOK_JWT_SECRET=dev-only-change-this

# Migrations/ops role — separate from the app role (spec §5)
MARKBOOK_DATABASE_MIGRATION_URL=postgresql+psycopg://markbook_ops:markbook_ops_dev_password@localhost:5433/markbook
